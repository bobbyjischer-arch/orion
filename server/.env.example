# O.R.I.O.N. Environment Configuration (Development)
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Telegram Bot Token (получить через @BotFather)
TELEGRAM_TOKEN=your-telegram-bot-token-here

# URL core сервера (для бота, будет автоматически ngrok URL)
CORE_URL=http://localhost:8080

# Секретный код для отмены тревоги
SECRET_CODE=change-me

# Общий ключ доступа к защищённым эндпоинтам core (X-Orion-Key).
# Генерация: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Пусто = auth выключен (только для локальной разработки).
ORION_API_KEY=

# Telegram ID владельца. Пусто = первый, кто напишет /start, становится владельцем.
OWNER_CHAT_ID=

# Порт для dev сервера (ngrok будет проксировать этот порт)
PORT=8080

# ── O.R.I.O.N. «Мозг» ────────────────────────────────────────────
# Базовый мозг — AEGIS (core/aegis.py): автономный, работает ВСЕГДА,
# без сети, ключей и нейросети. Настройки ниже — опциональное усиление.
# Бэкенд нейро-усиления: openrouter | ollama | auto
#   auto — сначала локальный Ollama, при недоступности — OpenRouter,
#   иначе остаётся чистый AEGIS (это нормальный рабочий режим).
LLM_BACKEND=auto

# Ключ OpenRouter (https://openrouter.ai/keys) — для backend=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Модель OpenRouter. По умолчанию — бесплатная.
# Примеры: deepseek/deepseek-chat-v3-0324:free, google/gemma-2-9b-it:free
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Локальная нейросеть через Ollama (backend=ollama|auto).
# Установи Ollama (https://ollama.com), затем: ollama pull gemma2:2b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
